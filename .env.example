# Copy to .env and fill in before running: cp .env.example .env

# Cloudflare Tunnel token.
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel
# (choose "Cloudflared"), then copy the token from the install command.
CF_TUNNEL_TOKEN=

# Largest file a visitor may upload, in megabytes.
MAX_UPLOAD_MB=100

# Optional: Cloudflare Web Analytics token (privacy-friendly, no cookies).
# Cloudflare dashboard -> Analytics & Logs -> Web Analytics -> Add a site ->
# copy the token from the <script data-cf-beacon='{"token":"..."}'> snippet.
# Leave blank to disable. (You can also enable Web Analytics with zero code
# straight from the Cloudflare dashboard, since the site is proxied.)
CF_BEACON_TOKEN=

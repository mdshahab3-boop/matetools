# Copy to .env and fill in before running: cp .env.example .env

# Cloudflare Tunnel token.
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel
# (choose "Cloudflared"), then copy the token from the install command.
CF_TUNNEL_TOKEN=

# Largest file a visitor may upload, in megabytes.
MAX_UPLOAD_MB=100
